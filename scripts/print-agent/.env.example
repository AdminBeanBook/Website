# Copy to .env next to print-agent.sh on the Mac (do not commit secrets).

PRINT_AGENT_SITE_URL=https://thebeanbook.com
PRINT_AGENT_SECRET=same-long-random-string-as-vercel
PRINT_QUEUE_NAME=Your_Label_Printer

# Optional
# PRINT_AGENT_POLL_SECONDS=60
# PRINT_AGENT_DRY_RUN=1
# PRINT_AGENT_LOG=/tmp/beanbook-print-agent.log
