generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model EmailSettings {
  id         String   @id @default("default")
  sendersJson String
  updatedAt  DateTime @updatedAt
}

model Contact {
  id             String       @id @default(cuid())
  name           String
  email          String?
  phone          String?
  notes          String?
  active         Boolean      @default(true)
  taxExempt      Boolean      @default(false)
  addressName    String?
  addressLine1   String?
  addressLine2   String?
  addressCity    String?
  addressState   String?
  addressPostal  String?
  addressCountry String?      @default("US")
  tags           ContactTag[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ContactTag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  color     String     @default("#226932")
  contacts  Contact[]
  customers Customer[]
  createdAt DateTime   @default(now())
}

model SentEmailBatch {
  id             String               @id @default(cuid())
  subject        String
  senderKey      String
  fromEmail      String               @default("")
  fromName       String               @default("")
  audience       String
  htmlBody       String
  recipientCount Int
  successCount   Int                  @default(0)
  failureCount   Int                  @default(0)
  sentByEmail    String
  dryRun         Boolean              @default(false)
  createdAt      DateTime             @default(now())
  recipients     SentEmailRecipient[]
}

model SentEmailRecipient {
  id        String         @id @default(cuid())
  batchId   String
  batch     SentEmailBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  status    String         @default("sent")
  error     String?
  createdAt DateTime       @default(now())

  @@index([batchId])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String   @default("")
  htmlBody  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String?
  phone     String?
  notes     String?
  tags      ContactTag[]
  orders    Order[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Product {
  id          String   @id
  name        String
  description String   @default("")
  priceCents  Int
  imageUrl    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PackagePreset {
  id        String   @id @default(cuid())
  name      String
  lengthIn  Float
  widthIn   Float
  heightIn  Float
  weightOz  Float
  isDefault Boolean  @default(false)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  stripeInvoiceId String?  @unique
  invoiceHostedUrl String?
  invoiceSentAt   DateTime?
  status          String   @default("paid")
  amountCents     Int
  discountCents   Int      @default(0)
  discountCode    String?
  productId       String?
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  customerEmail   String
  customerName    String?
  customerPhone   String?
  shippingName    String?
  shippingLine1   String?
  shippingLine2   String?
  shippingCity    String?
  shippingState   String?
  shippingPostal  String?
  shippingCountry String?  @default("US")
  packagePresetId   String?
  packagePreset     PackagePreset? @relation(fields: [packagePresetId], references: [id])
  shippoShipmentId   String?
  shippoTransactionId String?
  carrier            String?
  carrierService     String?
  trackingNumber     String?
  labelUrl           String?
  labelCostCents     Int?
  shippedAt          DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DiscountCode {
  id                    String    @id @default(cuid())
  code                  String    @unique
  type                  String
  value                 Int
  active                Boolean   @default(true)
  maxUses               Int?
  usedCount             Int       @default(0)
  expiresAt             DateTime?
  stripeCouponId        String?
  stripePromotionCodeId String?
  createdAt             DateTime  @default(now())
}

model PageContent {
  id             String    @id @default(cuid())
  slug           String    @unique
  path           String?   @unique
  template       String    @default("content")
  enabled        Boolean   @default(true)
  showInNav      Boolean   @default(false)
  sortOrder      Int       @default(0)
  isSystem       Boolean   @default(false)
  title          String
  subtitle       String?
  body           String    @default("")
  placedImages   String    @default("[]")
  textColors     String?
  sections       String    @default("[]")
  publishedAt    DateTime  @default(now())
  draftTitle     String?
  draftSubtitle  String?
  draftBody      String?
  draftPlacedImages String?
  draftTextColors String?
  draftSections  String?
  draftPath      String?
  draftTemplate  String?
  draftEnabled   Boolean?
  draftShowInNav Boolean?
  draftUpdatedAt DateTime?
  updatedAt      DateTime  @updatedAt
}

model SiteSettings {
  id              String   @id @default("default")
  publishedConfig String
  draftConfig     String
  publishedAt     DateTime @default(now())
  draftUpdatedAt  DateTime?
  updatedAt       DateTime @updatedAt
}

model CoffeeShop {
  id            String   @id @default(cuid())
  name          String
  email         String   @default("")
  website       String   @default("")
  locationLabel String   @default("Location")
  locationsJson String
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// App-facing partner shops (shared Supabase `shops` table used by the mobile app)
model AppShop {
  id            String   @id @db.Uuid
  name          String
  address       String   @default("")
  lat           Float
  lng           Float
  neighborhood  String   @default("")
  hoursJson     Json     @map("hours_json")
  discountText  String   @map("discount_text")
  discountText2 String?  @map("discount_text_2")
  description   String?
  logoUrl       String?  @map("logo_url")
  emoji         String   @default("☕")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime? @map("created_at")
  partnerAccess ShopPartnerAccess[]
  deals         AppDeal[]

  @@map("shops")
}

/// Limited-time shop promos (app `deals` table — not Bean Book membership coupons)
model AppDeal {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId      String    @map("shop_id") @db.Uuid
  title       String
  body        String
  startsAt    DateTime? @map("starts_at")
  expiresAt   DateTime  @map("expires_at")
  radiusMiles Decimal   @default(5.0) @map("radius_miles") @db.Decimal(4, 1)
  sentAt      DateTime? @map("sent_at")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  shop        AppShop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("deals")
  @@index([expiresAt], map: "idx_deals_expires_at")
}

/** Shop partner portal accounts (separate from AdminUser) */
model ShopPartnerUser {
  id           String              @id @default(cuid())
  email        String              @unique
  passwordHash String
  name         String              @default("")
  /// shop_super_admin | shop_owner
  role         String              @default("shop_owner")
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  shops        ShopPartnerAccess[]
}

model ShopPartnerAccess {
  partnerId String
  shopId    String          @db.Uuid
  partner   ShopPartnerUser @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  shop      AppShop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([partnerId, shopId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/** Admin bookmarks for reporting dashboards and other external tools. */
model AdminLink {
  id        String   @id @default(cuid())
  name      String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Admin calendar: tax deadlines and other reminders. */
model CalendarEvent {
  id              String   @id @default(cuid())
  title           String
  notes           String?
  date            DateTime @db.Date
  category        String   @default("other")
  recurrence      String   @default("none")
  completedDates  String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
}
